#!/usr/bin/env bash

function powermenu {
  options="Cancel\nLock\nQuit\nReboot\nPoweroff"
  selected=$(echo -e $options | dmenu_compat -noi -c -bw 2 -l 5 -p " powermenu" -i -nb "#11111b" -nf "#a6adc8" -sb "#1e1e2e" -sf "#cdd6f4")

  if [[ $selected = "Poweroff" ]]; then
    #doas /sbin/poweroff # alpine linux
    sudo systemctl poweroff # arch linux
  elif [[ $selected = "Reboot" ]]; then
    #doas /sbin/reboot # alpine linux
    sudo systemctl reboot # arch linux
  elif [[ $selected = "Lock" ]]; then
    # slock on X11, hyprlock on Wayland (see slock_now)
    slock_now
  elif [[ $selected = "Quit" ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      # Hyprland: exit the compositor (same as Alt+Shift+q)
      hyprctl dispatch 'hl.dsp.exit()'
    else
      xdotool key --clearmodifiers alt+shift+q
    fi
  elif [[ $selected = "Cancel" ]]; then
    return
  fi
}

powermenu
