#!/usr/bin/env bash
# dmenu_compat - one menu command for both sessions.
#   X11:     runs the real (patched) dmenu with the arguments unchanged.
#   Wayland: translates the dmenu flags used in these scripts to fuzzel --dmenu.
# Install as ~/scripts/dmenu_compat (must be in PATH).

if [ -z "$WAYLAND_DISPLAY" ]; then
  exec dmenu "$@"
fi

prompt="" lines="" bw="" bottom=0 centered=0 width=45
font="CaskaydiaCove Nerd Font:size=14"
nb="" nf="" sb="" sf=""

while [ $# -gt 0 ]; do
  case "$1" in
    -p)
      prompt="$2"
      shift
      ;;
    -l)
      lines="$2"
      shift
      ;;
    -bw)
      bw="$2"
      shift
      ;;
    -fn)
      font="$2"
      shift
      ;;
    -nb)
      nb="$2"
      shift
      ;;
    -nf)
      nf="$2"
      shift
      ;;
    -sb)
      sb="$2"
      shift
      ;;
    -sf)
      sf="$2"
      shift
      ;;
    -b) bottom=1 ;;
    # -c: centered box (fuzzel default). -i, -noi: nothing to translate (fuzzel matches
    # case-insensitively and always shows the input line)
    -c) centered=1 ;;
    -i | -noi) ;;
    *) ;;
  esac
  shift
done

# "#rrggbb" -> "rrggbbAA" (fuzzel wants RRGGBBAA without '#'); alpha defaults to ff (opaque)
rgba() { printf '%s%s' "${1#\#}" "${2:-ff}"; }
# Same as `alpha = 0xe0` in dmenu's config.h: translucent backgrounds, opaque text
BG_ALPHA=e0

# --width is in characters: 45 chars is about the 500px min_width of dmenu at this font size
# Without -c, dmenu draws a bar over the full monitor width (cliphist uses -b without -c).
# fuzzel has no pixel width, only characters, so compute the characters from the monitor width.
# CHAR_PX is the width of one character in pixels. 16.1 is an estimate for the 14pt font on
# a 32" 4K monitor (DPI-aware); change it if the bar is too wide (raise it) or too narrow (lower it).
CHAR_PX=16.1
if [ "$bottom" -eq 1 ] && [ "$centered" -eq 0 ]; then
  mon_px=$(hyprctl monitors -j 2>/dev/null |
    jq -r '[.[] | select(.focused)][0] | (.width / .scale) | floor' 2>/dev/null)
  case "$mon_px" in
    '' | null | *[!0-9]*) mon_px=3840 ;;
  esac
  width=$(awk -v w="$mon_px" -v c="$CHAR_PX" 'BEGIN { printf "%d", w / c }')
fi
args=(--dmenu --width="$width" --border-radius=10 --no-icons --horizontal-pad=14 --vertical-pad=10)
[ -n "$prompt" ] && args+=(--prompt="$prompt ")
[ -n "$lines" ] && args+=(--lines="$lines")
[ -n "$bw" ] && args+=(--border-width="$bw")
[ -n "$font" ] && args+=(--font="$font")
[ "$bottom" -eq 1 ] && args+=(--anchor=bottom)
[ -n "$nb" ] && args+=(--background="$(rgba "$nb" "$BG_ALPHA")")
[ -n "$nf" ] && args+=(--text-color="$(rgba "$nf")")
[ -n "$sb" ] && args+=(--selection-color="$(rgba "$sb" "$BG_ALPHA")" --border-color="$(rgba "$sb")")
[ -n "$sf" ] && args+=(--selection-text-color="$(rgba "$sf")" --selection-match-color=cba6f7ff)
# Matches: blue (Catppuccin Blue) in the list, mauve inside the selected row.
# Typed input, prompt and counter use the normal text color instead of the solarized defaults.
[ -n "$nf" ] && args+=(--input-color="$(rgba "$nf")" --prompt-color="$(rgba "$nf")" --match-color=89b4faff --counter-color="$(rgba "$nf")")

exec fuzzel "${args[@]}"
