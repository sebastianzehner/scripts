#!/usr/bin/env bash
# Screenshot utility with a menu interface. The backend is chosen by $WAYLAND_DISPLAY:
#   X11 (dwm):           import, xdotool, slop, magick, xsel
#   Wayland (Hyprland):  grim, slurp, hyprctl, jq, hyprpicker, quickshell
# Usage: screenshot [full|window|area]
# Run without arguments to use menu interface or 'Alt' + 'Shift' + '5'.

WAYLAND=0
[ -n "${WAYLAND_DISPLAY:-}" ] && WAYLAND=1

# Check for required commands
if [ "$WAYLAND" -eq 1 ]; then
  REQUIRED_CMDS=("grim" "slurp" "hyprctl" "jq" "quickshell" "qmenu" "notify-send")
else
  REQUIRED_CMDS=("import" "xdotool" "dmenu" "qmenu" "notify-send")
fi
for cmd in "${REQUIRED_CMDS[@]}"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: Required command '$cmd' not found in PATH." >&2
    exit 1
  fi
done

# Load XDG user dirs locally
USER_DIRS="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
# shellcheck source=/dev/null
[ -f "$USER_DIRS" ] && source "$USER_DIRS"

# Define screenshot directory using XDG standard
OUTDIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
mkdir -p "$OUTDIR"

# Filename with timestamp
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
FILENAME="${OUTDIR}/${TIMESTAMP}.png"

# Geometry "x,y WxH" of the active Hyprland window, empty if there is none
wayland_active_window_geometry() {
  hyprctl activewindow -j 2>/dev/null |
    jq -r 'select(.address != null) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

# Take screenshot based on given mode
take_screenshot() {
  case "$1" in
    full)
      if [ "$WAYLAND" -eq 1 ]; then
        grim "$FILENAME" && send_notification
      else
        import -window root "$FILENAME" && send_notification
      fi
      ;;
    window)
      if [ "$WAYLAND" -eq 1 ]; then
        GEOM=$(wayland_active_window_geometry)
        if [ -n "$GEOM" ]; then
          grim -g "$GEOM" "$FILENAME" && send_notification
        else
          notify-send "No active window detected"
          exit 1
        fi
      else
        # Get active window ID using xdotool
        WIN_ID=$(xdotool getactivewindow 2>/dev/null)
        if [ -n "$WIN_ID" ]; then
          import -window "$WIN_ID" "$FILENAME" && send_notification
        else
          notify-send "No active window detected"
          exit 1
        fi
      fi
      ;;
    area)
      if [ "$WAYLAND" -eq 1 ]; then
        GEOM=$(slurp) || exit 1
        grim -g "$GEOM" "$FILENAME" && send_notification
      else
        import "$FILENAME" && send_notification
      fi
      ;;
    help)
      echo "Usage: screenshot [full|window|area]"
      echo "Or run without arguments to use menu interface."
      ;;
    *)
      echo "Invalid option" && exit 1
      ;;
  esac
}

colorpicker() {
  if [ "$WAYLAND" -eq 1 ]; then
    # Dependencies: hyprpicker, wl-clipboard, magick (hyprpicker -a copies the color itself)
    for cmd in hyprpicker magick; do
      command -v "$cmd" >/dev/null 2>&1 || {
        notify-send "Missing: $cmd"
        return 1
      }
    done

    HEX=$(hyprpicker -a) || return 1

    # Small swatch of the picked color for the notification
    TMP="$(mktemp --suffix=.png)"
    trap '[[ -f "$TMP" ]] && rm -f "$TMP"' EXIT
    magick -size 64x64 "xc:$HEX" "$TMP"

    notify-send -i "$TMP" "Color picked: $HEX"
    return
  fi

  # Dependencies: magick, xsel, slop
  for cmd in magick xsel slop; do
    command -v "$cmd" >/dev/null 2>&1 || {
      notify-send "Missing: $cmd"
      return 1
    }
  done

  TMP="$(mktemp --suffix=.png)"
  trap '[[ -f "$TMP" ]] && rm -f "$TMP"' EXIT

  # Select a small area using slop
  GEOM=$(slop -t 0) || return 1

  # Screenshot of selected area
  import -window root -crop "$GEOM" "$TMP"

  # Extract hex color
  HEX=$(magick "$TMP" -scale 1x1\! -format "#%[hex:p{0,0}]" info: 2>/dev/null || echo "#??????")

  # Copy to clipboard
  printf "%s\n" "$HEX" | xsel -b -i

  # Notification with preview
  notify-send -i "$TMP" "Color picked: $HEX"
}

send_notification() {
  if [ -s "$FILENAME" ]; then
    notify-send "Screenshot saved" "$(basename "$FILENAME")"
  else
    notify-send "Screenshot failed" "$FILENAME"
  fi
}

# Show the menu if no argument is passed
# Delay to allow qmenu to close before capturing
if [ -z "$1" ]; then
  CHOICE=$(printf " \nFull Screen\nSelect Area\nActive Window\n \nColor Picker\nQR Secret Key\n \nGoto  record" | qmenu -noi -c -bw 2 -l 9 -p "󰹑 screenshot" -i -nb "#11111b" -nf "#a6adc8" -sb "#1e1e2e" -sf "#cdd6f4")
  case "$CHOICE" in
    "Full Screen") (sleep 0.3 && take_screenshot full) & ;;
    "Select Area") (sleep 0.3 && take_screenshot area) & ;;
    "Active Window") (sleep 0.3 && take_screenshot window) & ;;
    "Color Picker") (sleep 0.3 && colorpicker) & ;;
    "QR Secret Key") (sleep 0.3 && qr2totp) & ;;
    "Goto  record") record & ;;
    *) exit 0 ;;
  esac
else
  take_screenshot "$1"
fi
