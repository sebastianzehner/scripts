#!/bin/bash
# Gamescope + MangoHud wrapper for Steam launch options.
# On X11 the compositor (picom) is paused while the game runs and restored afterwards.
# On Wayland (Hyprland) there is no picom to handle, gamescope runs as a nested client.

restart_picom=0
if [ -z "${WAYLAND_DISPLAY:-}" ] && pgrep -x picom >/dev/null; then
  pkill -x picom
  sleep 0.5
  restart_picom=1
fi

# Ensure picom restarts even if something crashes
restore() {
  [ "$restart_picom" -eq 1 ] && { picom & }
}
trap restore EXIT

# Example for 1080p:
# gamescope -W 1920 -H 1080 -r 60 -f -- mangohud "$@"
# Example for 1440p:
# gamescope -W 2560 -H 1440 -r 60 -f -- mangohud "$@"
# Example for 4K:
gamescope -W 3840 -H 2160 -r 60 -f -- mangohud "$@"
