#!/bin/bash
#
# comfy script - start/stop ComfyUI + Brave kiosk instance
#
# Usage:
#   comfy          Start ComfyUI (if not already running) and open Brave
#   comfy stop     Stop Brave (kiosk instance) and the ComfyUI tmux session
#   comfy restart  Restart ComfyUI and reload Brave
#   comfy update   Update ComfyUI (ComfyUI must be stopped first)
#   comfy status   Show whether ComfyUI, Brave, and the tmux session are running
#   comfy version  Show script, ComfyUI, and Manager version
#   comfy help     Show this help message
#

COMFY_DIR="/mnt/sumpf/ai/ComfyUI"
COMFY_URL="http://127.0.0.1:8188/"
TMUX_SESSION="comfyui"
CONDA_ENV="comfy"
BRAVE_PROFILE="$HOME/.config/brave-comfy"
BRAVE_CLASS="Brave-browser"
COMFY_HOST=$(echo "$COMFY_URL" | sed -E 's#^[a-zA-Z]+://##; s#[:/].*$##')
APP_NAME="ComfyUI"
ICON="$HOME/scripts/icons/selfhst--comfyui-light.svg"
COMFY_LAUNCH_CMD="python main.py --listen 0.0.0.0 --enable-manager"
SCRIPT_VERSION="1.7.0"

show_version() {
    echo "comfy script v$SCRIPT_VERSION"
    echo ""

    if [ ! -d "$COMFY_DIR" ]; then
        echo "ComfyUI directory not found: $COMFY_DIR"
        exit 1
    fi

    cd "$COMFY_DIR"

    COMFY_VERSION=$(grep '^version' pyproject.toml | cut -d'"' -f2)
    COMFY_COMMIT=$(git log -1 --format="%h (%cd)" --date=local)

    source "/opt/miniconda3/etc/profile.d/conda.sh"
    conda activate "$CONDA_ENV"
    MANAGER_VERSION=$(pip show comfyui-manager 2>/dev/null | grep '^Version' | cut -d' ' -f2)

    echo "ComfyUI:  v$COMFY_VERSION  $COMFY_COMMIT"
    echo "Manager:  v${MANAGER_VERSION:-not found}"
}

notify() {
    # $1 = title, $2 = message, $3 = urgency (low|normal|critical), optional
    notify-send -a "$APP_NAME" -u "${3:-low}" -i "$ICON" -h string:x-dunst-stack-tag:comfy "$1" "$2" 2>/dev/null
}

show_help() {
    cat << EOF
comfy script v$SCRIPT_VERSION - start/stop/restart ComfyUI + Brave kiosk instance

Usage:
  comfy          Start ComfyUI (if not already running) and open Brave
                 pointed at the local web interface
  comfy stop     Stop the Brave kiosk instance and the ComfyUI tmux session
  comfy restart  Restart ComfyUI and reload Brave
  comfy update   Update ComfyUI (ComfyUI must be stopped first)
  comfy status   Show whether ComfyUI, Brave, and the tmux session are running
  comfy version  Show script, ComfyUI, and Manager version
  comfy help     Show this help message

Details:
  - ComfyUI runs inside a detached tmux session named "$TMUX_SESSION"
    (attach with: tmux attach -t $TMUX_SESSION)
  - Brave runs with a separate profile ("$BRAVE_PROFILE"),
    independent from your regular Brave instance
  - 'comfy restart' sends Ctrl+C into the tmux pane and restarts ComfyUI
    there, then reloads Brave via xdotool/xprop (requires both installed)
EOF
}

show_status() {
    if curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
        echo "ComfyUI: running ($COMFY_URL)"
    else
        echo "ComfyUI: not running"
    fi

    if pgrep -f "brave-comfy" > /dev/null 2>&1; then
        echo "Brave (ComfyUI): running"
    else
        echo "Brave (ComfyUI): not running"
    fi

    if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
        echo "tmux session '$TMUX_SESSION': active"
    else
        echo "tmux session '$TMUX_SESSION': not found"
    fi
}

start_comfy() {
    if curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
        echo "ComfyUI is already running."
    else
        echo "ComfyUI is not running, starting it..."
        notify "ComfyUI" "Starting ComfyUI, please wait..."

        tmux kill-session -t "$TMUX_SESSION" 2>/dev/null

        tmux new-session -d -s "$TMUX_SESSION" -n comfy

        tmux send-keys -t "$TMUX_SESSION" "source '/opt/miniconda3/etc/profile.d/conda.sh'" Enter
        tmux send-keys -t "$TMUX_SESSION" "conda activate '$CONDA_ENV'" Enter
        tmux send-keys -t "$TMUX_SESSION" "cd '$COMFY_DIR'" Enter
        tmux send-keys -t "$TMUX_SESSION" "export COMFYUI_MODEL_PATH='$COMFY_DIR/models'" Enter
        tmux send-keys -t "$TMUX_SESSION" "$COMFY_LAUNCH_CMD" Enter

        echo -n "Waiting for ComfyUI"
        for i in $(seq 1 60); do
            if curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
                echo " -> ready!"
                break
            fi
            echo -n "."
            sleep 1
        done

        if ! curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
            echo "ComfyUI did not become reachable within 60 seconds. Aborting."
            notify "ComfyUI" "Failed to start within 60 seconds. Check: tmux attach -t $TMUX_SESSION" critical
            exit 1
        fi

        notify "ComfyUI" "ComfyUI is ready, opening Brave..."
    fi
}

start_brave() {
    if pgrep -f "brave-comfy" > /dev/null 2>&1; then
        echo "Brave (ComfyUI) is already running, not opening another instance."
        return
    fi

    brave --app="$COMFY_URL" \
      --user-data-dir="$BRAVE_PROFILE" \
      --password-store=basic \
      --disable-save-password-bubble
}

reload_brave() {
    if ! pgrep -f "brave-comfy" > /dev/null 2>&1; then
        return
    fi

    if ! command -v xdotool > /dev/null 2>&1 || ! command -v xprop > /dev/null 2>&1; then
        echo "xdotool/xprop not found, skipping Brave reload."
        return
    fi

    WID=""
    for candidate in $(xdotool search --class "$BRAVE_CLASS" 2>/dev/null); do

        if xprop -id "$candidate" WM_CLASS 2>/dev/null | grep -q "\"$COMFY_HOST\""; then
            WID="$candidate"
            break
        fi
    done

    if [ -z "$WID" ]; then
        echo "Could not find the Brave (ComfyUI) window, skipping reload."
        return
    fi

    xdotool key --window "$WID" F5
    echo "Reloaded Brave."
}

stop_all() {
    echo "Stopping Brave..."
    pkill -f "brave-comfy" 2>/dev/null

    echo "Stopping ComfyUI tmux session..."
    tmux kill-session -t "$TMUX_SESSION" 2>/dev/null

    echo "Done."
    notify "ComfyUI" "Brave and ComfyUI stopped."
}

restart_comfy() {
    if ! curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
        echo "ComfyUI is not running, starting it fresh instead."
        start_comfy
        start_brave
        return
    fi

    if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
        echo "ComfyUI is reachable, but the tmux session '$TMUX_SESSION' is gone."
        echo "Can't send it a restart. Try: comfy stop && comfy"
        notify "ComfyUI" "Restart failed: tmux session not found." critical
        exit 1
    fi

    echo "Restarting ComfyUI..."
    notify "ComfyUI" "Restarting ComfyUI, please wait..."

    tmux send-keys -t "$TMUX_SESSION" C-c

    echo -n "Waiting for ComfyUI to shut down"
    for i in $(seq 1 15); do
        if ! curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
            echo " -> stopped."
            break
        fi
        echo -n "."
        sleep 1
    done

    tmux send-keys -t "$TMUX_SESSION" "$COMFY_LAUNCH_CMD" Enter

    echo -n "Waiting for ComfyUI to come back"
    for i in $(seq 1 60); do
        if curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
            echo " -> ready!"
            break
        fi
        echo -n "."
        sleep 1
    done

    if ! curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
        echo "ComfyUI did not come back within 60 seconds."
        echo "Check: tmux attach -t $TMUX_SESSION"
        notify "ComfyUI" "Restart failed, check tmux session." critical
        exit 1
    fi

    reload_brave

    echo "ComfyUI restarted."
    notify "ComfyUI" "ComfyUI restarted and ready."
}

update_comfy() {
    if curl -s --head --max-time 1 "$COMFY_URL" > /dev/null 2>&1; then
        echo "ComfyUI is currently running. Please stop it first with: comfy stop"
        notify "ComfyUI Update" "Still running. Stop first: comfy stop" critical
        exit 1
    fi

    echo "Starting ComfyUI update..."
    notify "ComfyUI Update" "Update started, please wait..."

    source "/opt/miniconda3/etc/profile.d/conda.sh"
    conda activate "$CONDA_ENV"

    cd "$COMFY_DIR" || {
        echo "ComfyUI directory not found: $COMFY_DIR"
        notify "ComfyUI Update" "Update failed: directory not found." critical
        exit 1
    }

    VERSION_BEFORE=$(grep '^version' pyproject.toml | cut -d'"' -f2)
    COMMIT_BEFORE=$(git log -1 --format="%h (%cd)" --date=local)
    MANAGER_BEFORE=$(pip show comfyui-manager 2>/dev/null | grep '^Version' | cut -d' ' -f2)

    echo "Updating ComfyUI core..."
    if ! git pull; then
        notify "ComfyUI Update" "git pull failed. Check terminal output." critical
        exit 1
    fi

    echo ""
    echo "Updating dependencies..."
    if ! pip install -r requirements.txt; then
        notify "ComfyUI Update" "Dependency update failed. Check terminal output." critical
        exit 1
    fi

    echo ""
    echo "Updating manager..."
    if ! pip install -r manager_requirements.txt; then
        notify "ComfyUI Update" "Manager update failed. Check terminal output." critical
        exit 1
    fi

    VERSION_AFTER=$(grep '^version' pyproject.toml | cut -d'"' -f2)
    COMMIT_AFTER=$(git log -1 --format="%h (%cd)" --date=local)
    MANAGER_AFTER=$(pip show comfyui-manager 2>/dev/null | grep '^Version' | cut -d' ' -f2)

    echo ""
    echo "==============================="
    echo "Update complete."
    echo "==============================="
    echo "Before:  v$VERSION_BEFORE  $COMMIT_BEFORE - Manager: $MANAGER_BEFORE"
    echo "After:   v$VERSION_AFTER  $COMMIT_AFTER - Manager: $MANAGER_AFTER"
    echo "==============================="
    echo ""
    echo "Start ComfyUI with: comfy"

    notify "ComfyUI Update" "Update completed successfully."
}

case "$1" in
    stop)
        stop_all
        ;;
    restart)
        restart_comfy
        ;;
    update)
        update_comfy
        ;;
    status)
        show_status
        ;;
    version)
        show_version
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        start_comfy
        start_brave
        ;;
    *)
        echo "Unknown option: $1"
        echo "Run 'comfy --help' for usage."
        exit 1
        ;;
esac
